  3.8307135920921717`*^9}},ExpressionUUID->"7008d6b1-01d9-4d7b-a9fe-\
c5a6a32ceae5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", "[", "x_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox["x", "2"], "/;", 
   RowBox[{"x", ">", "2"}]}]}]], "Input",
 CellChangeTimes->{{3.8307135960869293`*^9, 3.830713613836356*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"b676950d-7dd3-42ea-8cc9-edb9fae7170b"]
}, Closed]],

Cell[CellGroupData[{

Cell["Piecewise/hybrid functions", "Subsection",
 CellChangeTimes->{{3.8307137309091673`*^9, 3.830713741167615*^9}, 
   3.830713872626153*^9},ExpressionUUID->"02a7275b-3736-4ce4-b98d-\
46450fdb7102"],

Cell[CellGroupData[{

Cell["Defining Piecewise/hybrid functions", "Subsubsection",
 CellChangeTimes->{{3.83071387858558*^9, 
  3.830713884446155*^9}},ExpressionUUID->"93eda793-300c-48b2-96ba-\
72ec5c495165"],

Cell[TextData[{
 "Using piecewise[ ]:\n",
 StyleBox["Piecewise[{ {",
  FontSize->24],
 StyleBox["expr1, dom1",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}, {",
  FontSize->24],
 StyleBox["expr2, dom2",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}, ... }]\n\t",
  FontSize->24],
 StyleBox["Note that the expressions must be contained in a bracket together\n\
\t",
  FontSize->14],
 StyleBox["Note that to define areas where the function is constant, always \
type it after areas with actual curves as this overrides the curve and makes \
the entire piecewise the value if defined before the curves",
  FontSize->14,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.830713766270993*^9, 3.830713848046837*^9}, {
  3.830713907182012*^9, 3.83071391968355*^9}, {3.838364397363779*^9, 
  3.8383644525332317`*^9}},ExpressionUUID->"c51dd431-3939-4c88-b132-\
9ce9420c3e13"],

Cell[BoxData[
 RowBox[{
  RowBox[{"b", "[", "x_", "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["x", "3"], "-", "x"}], ",", 
       RowBox[{"x", "<", "0"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["x", "2"], ",", 
       RowBox[{"x", ">", "0"}]}], "}"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.830713852015687*^9, 3.830713938279455*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"bbbe3f8a-f84e-4c46-a64b-657554d2529b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Graphing piecewise/hybrid functions", "Subsubsection",
 CellChangeTimes->{{3.830713949391863*^9, 
  3.8307139552712297`*^9}},ExpressionUUID->"58ad0e5a-4e09-4676-8de2-\
c59811237c2c"],

Cell["\<\
