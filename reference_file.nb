Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "-", 
     RowBox[{"k", " ", 
      FractionBox["s", 
       SqrtBox["n"]]}]}], ",", 
    RowBox[{"x", "+", 
     RowBox[{"k", 
      FractionBox["s", 
       SqrtBox["n"]]}]}]}], "}"}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]"}], ",", 
    RowBox[{"n", "\[Rule]"}], ",", 
    RowBox[{"k", "\[Rule]"}], ",", 
    RowBox[{"s", "->"}]}], "}"}]}]], "Input",
