In[1755]:=",ExpressionUUID->"20ea34ee-c7b5-4f5e-956b-2bc7fff1e9b1"],

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"Cartesian eqn y=\"\>", TextForm]], "InlineText",
       ExpressionUUID->"da4380c2-34ba-49fa-8f56-b0f3d2eeece1"],
      Text["Cartesian eqn y="]], 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"ArcSin", "[", "y", "]"}]}], "\[Equal]", 
       RowBox[{"ArcCos", "[", "x", "]"}]}], "||", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"ArcSin", "[", "y", "]"}]}], "\[Equal]", 
       RowBox[{"-", 
        RowBox[{"ArcCos", "[", "x", "]"}]}]}]}], GridBox[{
       {
        RowBox[{"y", "\[Rule]", 
         TemplateBox[{
           RowBox[{"-", 
             RowBox[{"Sin", "[", 
               FractionBox[
                RowBox[{"ArcCos", "[", "x", "]"}], "2"], "]"}]}], 
           InterpretationBox[
            DynamicModuleBox[{Typeset`open = False}, 
             TemplateBox[{"Expression", 
               StyleBox[
                TagBox[
                 TooltipBox["\"condition\"", 
                  TagBox[
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{"ArcCos", "[", "x", "]"}], "]"}]}], "\[Equal]", 
                    RowBox[{"-", 
                    FractionBox["\[Pi]", "2"]}]}], "&&", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", 
                    RowBox[{"Im", "[", 
                    RowBox[{"ArcCos", "[", "x", "]"}], "]"}]}], 
                    "\[GreaterEqual]", "0"}]}], ")"}], "||", 
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["\[Pi]", "2"]}], "<", 
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{"ArcCos", "[", "x", "]"}], "]"}]}], "<", 
                    FractionBox["\[Pi]", "2"]}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{"ArcCos", "[", "x", "]"}], "]"}]}], "\[Equal]", 
                    FractionBox["\[Pi]", "2"]}], "&&", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", 
                    FractionBox["1", "2"]}], " ", 
                    RowBox[{"Im", "[", 
                    RowBox[{"ArcCos", "[", "x", "]"}], "]"}]}], 
                    "\[LessEqual]", "0"}]}], ")"}]}], Short[#, 7]& ]], 
                 Annotation[#, 
                  Short[
                   Or[
                    And[Rational[-1, 2] Re[
                    ArcCos[$CellContext`x]] == Rational[-1, 2] Pi, 
                    Rational[-1, 2] Im[
                    ArcCos[$CellContext`x]] >= 0], Rational[-1, 2] Pi < 
                    Rational[-1, 2] Re[
                    ArcCos[$CellContext`x]] < Rational[1, 2] Pi, 
                    And[Rational[-1, 2] Re[
                    ArcCos[$CellContext`x]] == Rational[1, 2] Pi, 
                    Rational[-1, 2] Im[
                    ArcCos[$CellContext`x]] <= 0]], 7], "Tooltip"]& ], 
                "IconizedCustomName", StripOnInput -> False], 
               GridBox[{{
                  RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Or", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["1984", "IconizedItem"]}]}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
                "Column", 
                GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
               Dynamic[Typeset`open]}, "IconizedObject"]], 
            Or[
             And[Rational[-1, 2] Re[
                 ArcCos[$CellContext`x]] == Rational[-1, 2] Pi, 
              Rational[-1, 2] Im[
                 ArcCos[$CellContext`x]] >= 0], Rational[-1, 2] Pi < 
             Rational[-1, 2] Re[
                ArcCos[$CellContext`x]] < Rational[1, 2] Pi, 
             And[Rational[-1, 2] Re[
                 ArcCos[$CellContext`x]] == Rational[1, 2] Pi, 
              Rational[-1, 2] Im[
                 ArcCos[$CellContext`x]] <= 0]], SelectWithContents -> True, 
            Selectable -> False]},
          "ConditionalExpression"]}]}
      },
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.1]}, 
          Offset[0.2]}}]},
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"Domain\"\>", TextForm]], "InlineText",ExpressionUUID->
       "44f198b9-b217-4d4e-8146-f30a0e4fe896"],
      Text["Domain"]], 
     RowBox[{
      RowBox[{"-", "1"}], "\[LessEqual]", "x", "\[LessEqual]", 
      "1"}], "\<\"\"\>"},
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"Range\"\>", TextForm]], "InlineText",ExpressionUUID->
       "e048deb9-d84a-4648-9a8f-1c385ea10063"],
      Text["Range"]], 
     RowBox[{
      RowBox[{"-", "1"}], "\[LessEqual]", "y", "\[LessEqual]", 
      FractionBox["1", 
       SqrtBox["2"]]}], "\<\"\"\>"},
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"dy/dx\"\>", TextForm]], "InlineText",ExpressionUUID->
       "e5437efe-42c7-403b-8c24-8abe6e8cdd3b"],
      Text["dy/dx"]], 
     FractionBox[
      RowBox[{"Csc", "[", "t", "]"}], "4"], "\<\"\"\>"}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  TableForm[{{
     Text["Cartesian eqn y="], 
     Or[(-2) ArcSin[$CellContext`y] == ArcCos[$CellContext`x], 
      2 ArcSin[$CellContext`y] == -ArcCos[$CellContext`x]], {{$CellContext`y -> 
       ConditionalExpression[-Sin[Rational[1, 2] ArcCos[$CellContext`x]], 
         Or[
          And[Rational[-1, 2] Re[
              ArcCos[$CellContext`x]] == Rational[-1, 2] Pi, 
           Rational[-1, 2] Im[
              ArcCos[$CellContext`x]] >= 0], Rational[-1, 2] Pi < 
          Rational[-1, 2] Re[
             ArcCos[$CellContext`x]] < Rational[1, 2] Pi, 
          And[Rational[-1, 2] Re[
              ArcCos[$CellContext`x]] == Rational[1, 2] Pi, Rational[-1, 2] Im[
              ArcCos[$CellContext`x]] <= 0]]]}}}, {
     Text["Domain"], -1 <= $CellContext`x <= 1}, {
     Text["Range"], 
     Inequality[-1, LessEqual, $CellContext`y, LessEqual, 2^
      Rational[-1, 2]]}, {
     Text["dy/dx"], Rational[1, 4] Csc[$CellContext`t]}}]]], "Output",
 CellChangeTimes->{
  3.869790045766518*^9, {3.869792406859853*^9, 3.8697924245828533`*^9}, 
   3.8698721550487137`*^9, 3.8737488891850758`*^9},
 CellLabel->
  "Out[1755]//TableForm=",ExpressionUUID->"43931551-b7e8-4cb1-9b49-\
f966f4e3659d"]
}, Open  ]],

