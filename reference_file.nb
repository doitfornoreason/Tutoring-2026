Cell[CellGroupData[{

Cell["Converting a modulus expression into piecewise", "Subsection",
 CellChangeTimes->{{3.846115137071435*^9, 3.846115158193033*^9}, {
  3.846115198863481*^9, 
  3.846115201249887*^9}},ExpressionUUID->"a7cbbb76-af85-4455-bee5-\
63b389c55483"],

Cell[TextData[{
 StyleBox["PiecewiseExpand[ ",
  FontSize->24],
 StyleBox["expression ",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox[", Reals]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.846115182373021*^9, 
  3.846115208194707*^9}},ExpressionUUID->"b799fd6d-8020-494d-9529-\
d51f9676d339"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PiecewiseExpand", "[", 
    RowBox[{
     RowBox[{"RealAbs", "[", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       RowBox[{"2", "x"}], "-", "3"}], "]"}], ",", "Reals"}], "]"}], "//", 
   "FullSimplify"}], "//", "Expand"}]], "Input",
 CellChangeTimes->{{3.846115211614221*^9, 3.846115225343665*^9}, 
   3.846115520568448*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"a08343d2-48d7-42d4-bcec-93fb8a9234af"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\[Piecewise]", GridBox[{
       {
        RowBox[{"3", "-", 
         RowBox[{"2", " ", "x"}], "-", 
         SuperscriptBox["x", "2"]}], 
        RowBox[{
         RowBox[{"-", "3"}], "<", "x", "<", "1"}]},
       {
        RowBox[{
         RowBox[{"-", "3"}], "+", 
         RowBox[{"2", " ", "x"}], "+", 
         SuperscriptBox["x", "2"]}], 
        TagBox["True",
         "PiecewiseDefault",
         AutoDelete->True]}
      },
      AllowedDimensions->{2, Automatic},
      Editable->True,
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
