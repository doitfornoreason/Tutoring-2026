}, Open  ]],

Cell[TextData[{
 "Finding the value of dy/dx at a point\neg: Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "2"], "b"}], " ", "-", 
     RowBox[{"2", "ab"}], " ", "+", " ", "b"}], "=", "2"}], TraditionalForm]],
