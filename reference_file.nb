Cell[CellGroupData[{

Cell["Displaying the rules", "Subsubsection",
 CellChangeTimes->{{3.835641669104013*^9, 
  3.835641674226503*^9}},ExpressionUUID->"2cb3960b-09a4-420a-ac3a-\
b40d4db52bd5"],

Cell[TextData[{
 "To display the rules of a hybrid function f, use:\n",
 StyleBox["DownValues[{func. }]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.835641678959*^9, 
  3.835641709363778*^9}},ExpressionUUID->"86c161b3-6576-461f-8759-\
168a88ed85fa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DownValues", "[", "b", "]"}]], "Input",
 CellChangeTimes->{{3.835641723683852*^9, 3.8356417262346897`*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"34154134-d15c-4cd9-af25-75c436bb1c46"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
