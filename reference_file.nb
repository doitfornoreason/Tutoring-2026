Cell[CellGroupData[{

Cell["Creating tables to display varying probabilities", "Subsection",
 CellChangeTimes->{{3.8400047312626257`*^9, 
  3.8400047652292433`*^9}},ExpressionUUID->"c48d27bb-73da-46db-a7e9-\
40797bc6f35c"],

Cell[TextData[{
 "Tables can be used to show how the value of an expression changes as you \
iterate through a value:\n",
 StyleBox["Table[ {",
  FontSize->24],
 StyleBox["expr",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}, {",
  FontSize->24],
 StyleBox["var, var",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["min",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[", var",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["max",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["} ] //TableForm\n",
  FontSize->24],
 StyleBox["You can add multiple expressions in the first bracket (eg: making \
it {var, expr} to show the corresponding value of the variable)",
  FontSize->14,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.840004789467346*^9, 3.840004909030197*^9}, {
  3.84000501317311*^9, 
  3.840005036002727*^9}},ExpressionUUID->"6333131d-abe3-4b53-988b-\
e368bb3c3b2f"],

Cell["*Use Probability[...] if n is the changing variable**", "Text",
 CellChangeTimes->{{3.840041711137775*^9, 
  3.840041748478095*^9}},ExpressionUUID->"707132ec-f285-4a97-b160-\
5cd13a407b7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", ",", " ", 
      RowBox[{"Probability", "[", 
       RowBox[{
        RowBox[{"x", ">", "2"}], ",", 
        RowBox[{"x", "\[Distributed]", 
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{"n", ",", "0.14"}], "]"}]}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "5"}], "}"}]}], "]"}], "//", 
  "TableForm"}]], "Input",
 CellChangeTimes->{{3.8400049154938517`*^9, 3.840004924976782*^9}, {
  3.8400049792011633`*^9, 3.840005052332141*^9}},
 CellLabel->
