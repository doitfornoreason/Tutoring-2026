Cell[TextData[{
 StyleBox["norm2[...]\n",
  FontSize->24],
 StyleBox["Finds the norm of a vector without including Abs[...] (which \
Norm[...] does, and requires you to manually remove them)\n- specifically for \
vectors containing trig functions",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.874370201957924*^9, 
  3.8743702703360043`*^9}},ExpressionUUID->"c52f106f-3f3f-4b98-87c3-\
ef8c5cf68833"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Eg", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Norm", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "t", "]"}], ",", 
     RowBox[{"Cos", "[", "t", "]"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.874370273248178*^9, 3.874370287510333*^9}},
 CellLabel->
  "In[706]:=",ExpressionUUID->"cfb3d356-55e5-43f9-a5cb-dc1b4850b43d"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{"Cos", "[", "t", "]"}], "]"}], "2"], "+", 
   SuperscriptBox[
    RowBox[{"Abs", "[", 
     RowBox[{"Sin", "[", "t", "]"}], "]"}], "2"]}]]], "Output",
 CellChangeTimes->{3.874370288064842*^9},
 CellLabel->
  "Out[706]=",ExpressionUUID->"e3b6b1ea-f797-405e-ac1e-826cc0a325f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "vs", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"norm2", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "t", "]"}], ",", 
     RowBox[{"Cos", "[", "t", "]"}]}], "}"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.87437029410006*^9, 3.874370299914176*^9}},
 CellLabel->
  "In[707]:=",ExpressionUUID->"801c60c1-ea23-4833-b3bd-a7458190d080"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.874370300448245*^9},
 CellLabel->
  "Out[707]=",ExpressionUUID->"dbfc735d-58ff-4f6e-8cf3-fe6d258680bb"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Simplifying expressions for a restriction of parameters", "Subsection",
 CellChangeTimes->{{3.863565975821033*^9, 
  3.8635659993202744`*^9}},ExpressionUUID->"61e69792-025b-4db5-9135-\
cb5c2dc913d7"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"Eg", ":", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{
          RowBox[{"-", "2"}], "+", "n"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"2", " ", "n"}]]}], ")"}]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{
          RowBox[{"-", "2"}], "+", 
          RowBox[{"3", " ", "n"}]}]], " ", 
        SuperscriptBox["n", "2"]}], ")"}], "/", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], 
          RowBox[{"2", " ", "n"}]]}], ")"}], "2"]}]}]}], ",", " ", 
   RowBox[{
   "simplify", " ", "for", " ", "when", " ", "n", " ", "is", " ", "an", " ", 
    "integer"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.8635660009940243`*^9, 
  3.86356603696693*^9}},ExpressionUUID->"03fc1476-e364-46d5-a2e8-\
e674da409624"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"-", "2"}], "+", "n"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", "n"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"2", " ", "n"}]]}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        RowBox[{"3", " ", "n"}]}]], " ", 
      SuperscriptBox["n", "2"]}], ")"}], "/", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], 
        RowBox[{"2", " ", "n"}]]}], ")"}], "2"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.863566049981598*^9, 3.863566051479312*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"5ca42ad3-d810-46de-bad7-69688c8151b6"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "2"], " ", "n", " ", 
  RowBox[{"Sec", "[", 
   RowBox[{"n", " ", "\[Pi]"}], "]"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "-", 
    RowBox[{"\[ImaginaryI]", " ", "n", " ", 
     RowBox[{"Tan", "[", 
      RowBox[{"n", " ", "\[Pi]"}], "]"}]}]}], ")"}]}]], "Output",
