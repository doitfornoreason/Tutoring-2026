0a82d8dbd6b8"],

Cell["Using FunctionDomain[ ]", "Text",
 CellChangeTimes->{{3.830712695641254*^9, 
  3.830712701630319*^9}},ExpressionUUID->"df923be8-bb85-45e7-ac50-\
6ef23d0abc53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FunctionDomain", "[", 
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{"x", "+", "3"}], "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{
  3.8304649672777452`*^9, {3.830712687182475*^9, 3.830712714456032*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"72c5fc58-9ff3-4b50-92aa-b208f4998fab"],

Cell[BoxData[
 RowBox[{"x", ">", 
  RowBox[{"-", "3"}]}]], "Output",
 CellChangeTimes->{3.8307127149225388`*^9},
 CellLabel->"Out[15]=",ExpressionUUID->"33aef709-5532-478d-8875-54813279edf1"]
}, Open  ]],

Cell[TextData[{
 "If the command returns True, the domain is  ",
 Cell[BoxData[
  TemplateBox[{},
   "Reals"]],ExpressionUUID->"142b5a79-a651-4286-b31f-88833b527546"],
 ".\nEG:"
}], "Text",
