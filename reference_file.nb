Cell[BoxData[
 RowBox[{"u", ".", 
  RowBox[{"Normalize", "[", "v", "]"}]}]], "Input",
 CellChangeTimes->{{3.831872735877417*^9, 3.8318727406493473`*^9}},
 CellLabel->
  "In[412]:=",ExpressionUUID->"33576321-89e8-40ac-9215-f91474b1eb08"],

Cell[BoxData[
 RowBox[{
  RowBox[{"36", " ", 
   SqrtBox[
    FractionBox["5", "53"]]}], "+", 
  FractionBox["143", 
   SqrtBox["265"]]}]], "Output",
 CellChangeTimes->{3.831872741032817*^9},
 CellLabel->
  "Out[412]=",ExpressionUUID->"06031e2e-370c-4520-9990-4c358c75800e"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Testing for linear dependence", "Subsection",
 CellChangeTimes->{{3.861063490052476*^9, 
  3.8610634934145117`*^9}},ExpressionUUID->"ed4c3eda-0313-450c-80fd-\
46eabfb8fba2"],

Cell[TextData[{
 "Use LinearlyIndependent[ ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["v", "1"], ",", "...", " ", ",", 
     SubscriptBox["v", "n"]}]}], TraditionalForm]],ExpressionUUID->
  "838aff04-d241-44e0-90cf-0c9f21ae6078"],
 "} ]\n",
 StyleBox["Note that Column vectors do not work, only row vectors do.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.861063504848057*^9, 
  3.861063542149251*^9}},ExpressionUUID->"0a7be7a8-023f-4c86-94ad-\
90dbe53716db"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LinearlyIndependent", "[", GridBox[{
    {"1", "2", "3"},
    {"0", "0", "1"},
    {"1", "0", "0"}
   }], "]"}]], "Input",
 CellChangeTimes->{{3.861063496073554*^9, 3.861063497614008*^9}, {
  3.8610635436661053`*^9, 3.861063564823126*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"b2c3cb64-c52a-499d-ad72-fba2f63fe60e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.861063567978917*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"d14bc14f-449e-4766-aab6-d5186bb30455"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Eliminating parameters", "Subsection",
 CellChangeTimes->{{3.869777265483959*^9, 3.869777272564226*^9}, {
  3.8697773978052273`*^9, 
  3.869777416271912*^9}},ExpressionUUID->"a4b6d926-4534-4a3a-90ff-\
01b6053d652f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Eliminate", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "==", 
      RowBox[{"Sin", "[", "t", "]"}]}], ",", 
     RowBox[{"y", "\[Equal]", 
      RowBox[{"Cos", "[", "t", "]"}]}]}], "}"}], ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.8697774383265343`*^9, 3.8697774649766407`*^9}},
 CellLabel->
  "In[126]:=",ExpressionUUID->"906842a3-5811-4cf4-93f0-3846b36bdb1a"],

Cell[BoxData[
 TemplateBox[{
  "Eliminate", "ifun", 
   "\"Inverse functions are being used by \
\\!\\(\\*RowBox[{\\\"Eliminate\\\"}]\\), so some solutions may not be found; \
use Reduce for complete solution information.\"", 2, 126, 5, 
   29167841276112993733, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellChangeTimes->{{3.8697774573569727`*^9, 3.86977746558589*^9}},
 CellLabel->
  "During evaluation of \
In[126]:=",ExpressionUUID->"b018f6a0-498d-4a9c-a805-c3d7e332aed6"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["y", "2"], "\[Equal]", 
  RowBox[{"1", "-", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{{3.8697774573746443`*^9, 3.869777465593643*^9}},
 CellLabel->
  "Out[126]=",ExpressionUUID->"9b3cbb98-4755-4beb-bd77-4d0cf95fcd16"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["y", "2"], "\[Equal]", 
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]}], ",", "y"}], "]"}]], "Input",
 CellChangeTimes->{{3.86977741885262*^9, 3.869777431729959*^9}, {
  3.8697774722552767`*^9, 3.869777480151351*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"04af92ad-3a2a-4063-8f95-5693afd34579"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", "\[Rule]", 
     RowBox[{"-", 
      SqrtBox[
       RowBox[{"1", "-", 
        SuperscriptBox["x", "2"]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", "\[Rule]", 
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"]}]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.869777480390253*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"b9e78f19-69ba-463c-919e-0445d4f6d147"]
}, Open  ]]
}, Closed]],

