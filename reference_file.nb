Cell[CellGroupData[{

Cell["Scalar resolute", "Subsubsection",
 CellChangeTimes->{{3.831872639122952*^9, 
  3.831872641362392*^9}},ExpressionUUID->"3c77f91c-a0c9-4656-8902-\
0d9ecec7f7af"],

Cell[TextData[{
 "To calculate the ",
 StyleBox["scalar resolute",
  FontWeight->"Bold"],
 " of u in the direction of v, \[LineSeparator]",
 StyleBox["DO NOT use Norm[ Projection[u, v]] as it only gives positive \
values\nuse:\n",
  FontSize->16],
 StyleBox["u.Normalize[v]",
  FontSize->36]
}], "Text",
 CellChangeTimes->{{3.831872648701572*^9, 
  3.831872724715663*^9}},ExpressionUUID->"aac4e0a5-43f5-49b5-8f1b-\
4c738c312fea"],

