695ad1a718e8"],

Cell[TextData[{
 StyleBox["From polar coordinates to cartesian (r, theta)-> (x , y)\n",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["FromPolarCoordinates[{",
  FontSize->18],
 StyleBox["polar coords.",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["}]",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.838423340481749*^9, 
  3.838423390659009*^9}},ExpressionUUID->"adce5ec4-7f2f-43aa-a655-\
788aff59611c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FromPolarCoordinates", "[", 
  RowBox[{"{", 
   RowBox[{"2", ",", 
    FractionBox["Pi", "3"]}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.8384233940218563`*^9, 3.838423410230097*^9}},
