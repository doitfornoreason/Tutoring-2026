Cell[CellGroupData[{

Cell["Finding Range", "Subsubsection",
 CellChangeTimes->{{3.83046498114857*^9, 
  3.8304649833596077`*^9}},ExpressionUUID->"6b3c994b-e9fa-4ede-bd76-\
8aa06bdf264e"],

Cell[TextData[{
 "Finding ranges of functions without restricted domains:ss\n",
 StyleBox["FunctionDomain[{",
  FontSize->24],
 StyleBox["expr",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}, x, y]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.83046525259437*^9, 3.830465262432626*^9}, {
  3.830712791256596*^9, 
  3.830712898582905*^9}},ExpressionUUID->"11002148-fd27-47a7-ad77-\
f04f1b2affb6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FunctionRange", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["E", 
     RowBox[{"2", "x"}]], "-", "34"}], ",", "x", ",", "y"}], "]"}]], "Input",
 CellChangeTimes->{{3.8307129074885*^9, 3.830712917754809*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"96e60144-00e3-4214-9367-fb2cc5046577"],

Cell[BoxData[
 RowBox[{"y", ">", 
  RowBox[{"-", "34"}]}]], "Output",
 CellChangeTimes->{3.830712918190404*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"2b353232-9aa6-43e8-94c4-12ec950712c6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{"\"\<FunctionRange[{\!\(\*StyleBox[\"function\",FontSlant->\"\
Italic\"]\)\!\(\*StyleBox[\",\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\" \
\",FontSlant->\"Italic\"]\)\!\(\*StyleBox[\"Domain\",FontSlant->\"Italic\"]\)}\
,x,y]\>\"", "\[IndentingNewLine]", 
 RowBox[{"FunctionRange", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["x", "3"]}], "+", 
      RowBox[{"6", 
       SuperscriptBox["x", "2"]}]}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "<", "x", "<", "6"}]}], "}"}], ",", "x", ",", "y"}],
   "]"}]}], "Input",
 CellChangeTimes->{{3.83046498806842*^9, 3.830465059647758*^9}, {
  3.830465109987542*^9, 3.8304651315219393`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"fb4471bc-f83b-4d2f-8c63-b05607f82dcd"],

Cell[BoxData["\<\"FunctionRange[{\\!\\(\\*StyleBox[\\\"function\\\",FontSlant-\
>\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\",\\\",FontSlant->\\\"Italic\\\"]\\)\\\
!\\(\\*StyleBox[\\\" \
\\\",FontSlant->\\\"Italic\\\"]\\)\\!\\(\\*StyleBox[\\\"Domain\\\",FontSlant->\
\\\"Italic\\\"]\\)},x,y]\"\>"], "Output",
 CellChangeTimes->{3.830712779108735*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"05c955e0-f00b-4610-89ed-e5131b1ea9a4"],

Cell[BoxData[
 RowBox[{"0", "\[LessEqual]", "y", "\[LessEqual]", "32"}]], "Output",
 CellChangeTimes->{3.830712779355728*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"9e333c19-2024-4bb9-bd78-3d72bffa7dd8"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding inverse functions", "Subsection",
 CellChangeTimes->{{3.831325559096538*^9, 3.831325562106636*^9}, {
  3.8317745301435547`*^9, 
  3.831774534258581*^9}},ExpressionUUID->"4d37af97-5336-4879-8054-\
cb5d0cba4836"],

Cell[CellGroupData[{

Cell["Method 1)", "Subsubsection",
 CellChangeTimes->{{3.831325569592609*^9, 
  3.831325576539109*^9}},ExpressionUUID->"c75b14b4-ee4c-435d-b0b4-\
66e614bea72f"],

Cell[TextData[{
 "Swapping ",
 StyleBox["x ",
  FontSlant->"Italic"],
 "and ",
 StyleBox["y ",
  FontSlant->"Italic"],
 "and rearranging.\n\nfor f(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"3", "x"}]}], TraditionalForm]],ExpressionUUID->
  "e4a52479-f6d1-4738-9f95-2e5ecd563f94"],
 ",\n\tswap x and y\n\t\tx = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", 
     SuperscriptBox["y", "2"]}], "-", 
    RowBox[{"3", "y"}]}], TraditionalForm]],ExpressionUUID->
  "8f791598-b2bb-4a06-a338-3e6a44f0ee0e"],
 "\n\tSolve for y"
}], "Text",
 CellChangeTimes->{{3.831325598858917*^9, 
  3.831325769041525*^9}},ExpressionUUID->"b56aec19-bcdb-4d4f-aa8b-\
20e9d8d292a6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"x", " ", "==", 
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["y", "2"]}], "-", 
     RowBox[{"3", "y"}]}]}], ",", "y"}], "]"}]], "Input",
 CellChangeTimes->{{3.831325740872758*^9, 3.831325772018342*^9}},
 CellLabel->
  "In[383]:=",ExpressionUUID->"b27c6d31-080c-4649-8aac-d84078d402d7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"y", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{"3", "-", 
        SqrtBox[
         RowBox[{"9", "+", 
          RowBox[{"8", " ", "x"}]}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        SqrtBox[
         RowBox[{"9", "+", 
          RowBox[{"8", " ", "x"}]}]]}], ")"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.8313257727291107`*^9},
 CellLabel->
  "Out[383]=",ExpressionUUID->"4f2958d0-7a43-468f-a6aa-947f42340f7f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Method 2)", "Subsubsection",
 CellChangeTimes->{{3.8313255850721292`*^9, 
  3.8313255867094927`*^9}},ExpressionUUID->"f27f0099-5dee-4810-bb12-\
2827ea631ab3"],

Cell[TextData[{
 "*",
 StyleBox["The function must be defined for this method",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "*\nUsing:\n",
 StyleBox["InverseFunction[ f ][ x ]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.83132579501731*^9, 
  3.831325855267683*^9}},ExpressionUUID->"e99b546d-581c-44ae-94e3-\
584cf46602b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"2", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"3", "x"}]}], "/;", 
   RowBox[{
    FractionBox["3", "4"], ">=", "x"}]}]}]], "Input",
 CellChangeTimes->{{3.831325860924279*^9, 3.831325878720345*^9}, {
  3.831325912963828*^9, 3.831325914007369*^9}, {3.831325967858849*^9, 
  3.8313259994021883`*^9}},
 CellLabel->
  "In[390]:=",ExpressionUUID->"9b524d15-9c4b-421c-be31-bb74c63234f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"InverseFunction", "[", "f", "]"}], "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.831325883496752*^9, 3.8313258911583233`*^9}},
 CellLabel->
  "In[391]:=",ExpressionUUID->"0ddb0050-03ca-4257-bd78-68fdda161f6d"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"3", "-", 
    SqrtBox[
     RowBox[{"9", "+", 
      RowBox[{"8", " ", "x"}]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.831325892327304*^9, {3.831325995655332*^9, 3.8313260019390697`*^9}},
 CellLabel->
  "Out[391]=",ExpressionUUID->"26f1add2-b83c-4341-9e69-6d8d6996175f"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["nth roots", "Subsection",
 CellChangeTimes->{{3.831671831525133*^9, 
  3.831671832943914*^9}},ExpressionUUID->"a65f3b63-33e0-491b-8feb-\
ff4ab03e102a"],

Cell[CellGroupData[{

Cell["Calculating nth roots", "Subsubsection",
 CellChangeTimes->{{3.8316718653077297`*^9, 
  3.831671871924645*^9}},ExpressionUUID->"f4ed7ddb-523a-43e8-add5-\
99702b36f093"],

Cell[TextData[{
 "Use\n",
 StyleBox["Surd[ ",
  FontSize->24],
 StyleBox["x, exp ",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["]\nDO NOT use ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", 
     FractionBox["1", "n"]], " "}], TraditionalForm]],ExpressionUUID->
  "24479172-e201-4ec8-9072-8565650de2cd"],
 StyleBox["as it converts it into an imaginary number\nRaise the surd to a \
power if there is a number that isn\[CloseCurlyQuote]t 1 in the fraction: \
(Surd[ x , exp ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"]", ")"}], "a"], TraditionalForm]],ExpressionUUID->
  "e2953172-ffce-48e3-a69f-5e5a3b047b16"]
}], "Text",
 CellChangeTimes->{{3.831671881630211*^9, 3.831671932474659*^9}, {
  3.831671976661913*^9, 3.831672040282448*^9}, {3.8316740459336147`*^9, 
  3.831674046248776*^9}},ExpressionUUID->"2ceac6b1-383d-447f-8c28-\
19fcdf39c8c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Surd", "[", 
  RowBox[{"x", ",", "5"}], "]"}]], "Input",
 CellChangeTimes->{{3.831672051228034*^9, 3.83167205825309*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"65279807-d70c-4d59-99d0-9f848dc5f787"],

Cell[BoxData[
 RadicalBox["x", "5",
  MultilineFunction->None,
  SurdForm->True]], "Output",
 CellChangeTimes->{3.831672059350553*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"52dca498-1250-4f96-b11a-c0f6118c6ad8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plotting nth roots", "Subsubsection",
 CellChangeTimes->{{3.831673863015808*^9, 
  3.8316738669000196`*^9}},ExpressionUUID->"7ecf3f06-096b-462f-98f1-\
542f3700f970"],

Cell[TextData[{
 "Use ",
 StyleBox["Surd[ ",
  FontSize->24],
 StyleBox["x, exp ",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["]",
  FontSize->24],
 " Instead of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", 
    FractionBox["1", "n"]], TraditionalForm]],ExpressionUUID->
  "6fc17011-daba-43ef-a435-d90ced287147"],
 "as it only plots half of the graph. EG:\nRaise the surd to a power if there \
is a number that isn\[CloseCurlyQuote]t 1 in the fraction: (Surd[ x , exp ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"]", ")"}], "a"], TraditionalForm]],ExpressionUUID->
  "a667ff88-6f1c-4cb2-bd38-7dfdcab87343"]
}], "Text",
 CellChangeTimes->{{3.831673888484189*^9, 3.8316739389868937`*^9}, {
  3.831673973472679*^9, 
  3.831674039585897*^9}},ExpressionUUID->"1bf965e1-c296-44a1-8d4e-\
5efc00bfec44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Surd", "[", 
     RowBox[{"x", ",", "3"}], "]"}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "10"}], ",", "10"}], "}"}]}], "]"}]], "Input",
