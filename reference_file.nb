     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"denest", "[", 
     RowBox[{"n_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"Catch", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"val", ",", "x", ",", "poly", ",", "ints", ",", "power", ",", 
          RowBox[{"j", "=", "1"}], ",", "k", ",", "fax", ",", "soln"}], "}"}],
         ",", 
        RowBox[{
         RowBox[{"poly", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"RootReduce", "[", "n", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "x", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"power", "=", 
          RowBox[{"LCM", "@@", 
           RowBox[{"Denominator", "[", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"{", "n", "}"}], ",", 
              RowBox[{
               RowBox[{"Power", "[", 
                RowBox[{"a_", ",", "b_"}], "]"}], "\[RuleDelayed]", "b"}], 
              ",", 
              RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ints", "=", 
          RowBox[{"Sort", "[", 
