Cell[CellGroupData[{

Cell["Matrices", "Subsection",
 CellChangeTimes->{{3.831674294466113*^9, 
  3.831674295697237*^9}},ExpressionUUID->"2fb5183f-1748-473e-a8aa-\
baedc493b882"],

Cell[TextData[{
 "Matrices in Mathematica can be portrayed by a list within lists, where the \
curly brackets denote a list and the inner lists are rows. \[LineSeparator]To \
display the lists as a matrix, do ",
 StyleBox["//Matrixform",
  FontSize->18,
  FontWeight->"Bold"],
 "\[LineSeparator]EG:"
}], "Text",
 CellChangeTimes->{{3.8316743026991463`*^9, 
  3.8316743334573097`*^9}},ExpressionUUID->"b61f0104-f1eb-478d-adec-\
71ce10aec755"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "7"}], "}"}]}], "}"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.831674313020733*^9, 3.8316743130882473`*^9}, {
  3.8316743491611557`*^9, 3.831674365911749*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"847725f5-f86b-496b-a3fc-57ffa6592d25"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"a", "2"},
     {"1", "7"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.831674366659328*^9},
 CellLabel->
  "Out[24]//MatrixForm=",ExpressionUUID->"41c7f819-9506-4e20-9301-\
5ba620be3633"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Matrix Multiplication", "Subsubsection",
 CellChangeTimes->{{3.831674404105941*^9, 
  3.831674415738883*^9}},ExpressionUUID->"ffb69053-fd72-4db6-a113-\
c9c6bf6d2861"],

Cell["\<\
To perform matrix multiplication, use a fullstop instead of a normal gap or \
multiplication sign. EG:\
\>", "Text",
 CellChangeTimes->{{3.831674458673746*^9, 
  3.8316744808251*^9}},ExpressionUUID->"b1c7d096-bac6-496a-a759-da9a0dfdfe03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}], ".", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "8"}], "}"}]}], "}"}]}], "//", 
  "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.8316744888787937`*^9, 3.831674491857952*^9}, {
  3.831674523797398*^9, 3.831674541557848*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"a500150d-e7df-4582-bebd-041bf9ff00a2"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"11", "21"},
     {"25", "47"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.831674541992054*^9},
 CellLabel->
  "Out[25]//MatrixForm=",ExpressionUUID->"6d609061-f723-4b97-8786-\
7577f26842cc"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solving transformation questions with matrices", "Subsubsection",
 CellChangeTimes->{{3.831674649194861*^9, 
  3.831674657920223*^9}},ExpressionUUID->"f8db0ef2-382a-4212-b54f-\
c4a1ac7189f9"],

Cell["\<\
Use the solve[ ] command to find unknown variables, and define y\
\[CloseCurlyQuote] as yn and x\[CloseCurlyQuote] as xn. EG: \
\>", "Text",
 CellChangeTimes->{{3.83167466452464*^9, 3.831674697013034*^9}, {
  3.831674914028124*^9, 
  3.8316749239932623`*^9}},ExpressionUUID->"a07a2da0-3f33-48d0-a232-\
e0d4df750ca2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"yn", ",", "xn"}], "}"}], "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"9", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "5"}], "}"}]}], "}"}], ".", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}]}], "+", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"yn", ",", "xn"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.831674700450156*^9, 3.831674712326302*^9}, {
  3.831674755112402*^9, 3.831674845983121*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"eff01d63-7204-4981-b206-ba5c09459e50"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"yn", "\[Rule]", 
     RowBox[{"1", "+", 
      RowBox[{"9", " ", "x"}]}]}], ",", 
    RowBox[{"xn", "\[Rule]", 
     RowBox[{"4", "+", 
      RowBox[{"5", " ", "y"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.831674833293721*^9, 3.8316748432815447`*^9}},
 CellLabel->"Out[28]=",ExpressionUUID->"feca3a15-5cb0-4280-91fd-53a495714736"]
}, Open  ]],

Cell["Same as:", "Text",
 CellChangeTimes->{{3.831674863594865*^9, 
  3.831674873295384*^9}},ExpressionUUID->"dd70728a-519b-49ab-bf27-\
48c776f0afc9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"yn", ",", "xn"}], "}"}], "\[Equal]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"9", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "5"}], "}"}]}], "}"}], ".", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "+", 
    RowBox[{"{", 
     RowBox[{"1", ",", "4"}], "}"}]}]}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.831674876423171*^9, 3.831674892022674*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"369c6249-2ac1-42e2-aefc-5e32d919be95"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"{", 
    RowBox[{"yn", ",", "xn"}], "}"}], "\[Equal]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "+", 
      RowBox[{"9", " ", "x"}]}], ",", 
     RowBox[{"4", "+", 
      RowBox[{"5", " ", "y"}]}]}], "}"}]}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.8316748922898703`*^9},
 CellLabel->
  "Out[29]//MatrixForm=",ExpressionUUID->"8feedcc2-97f4-4a02-8b6c-\
755751f0da68"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Discriminant function", "Subsection",
 CellChangeTimes->{{3.8317745705964746`*^9, 
  3.831774573956937*^9}},ExpressionUUID->"ed1f2455-97f6-4b22-9071-\
51913406f4f5"],

Cell[TextData[{
 "The discriminant of a polynomial is given by:\n",
 StyleBox["Discriminant [ {",
  FontSize->24],
 StyleBox["eq",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}, {",
  FontSize->24],
 StyleBox["var",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["} ]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.831774578404395*^9, 
  3.831774604616252*^9}},ExpressionUUID->"a79dc1e7-a581-40f8-bfff-\
fe1114bd1a85"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Discriminant", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"14", 
     SuperscriptBox["x", "6"]}], "-", "12", "+", 
    RowBox[{"13", 
     SuperscriptBox["x", "3"]}]}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.83177461143778*^9, 3.8317746371393547`*^9}},
 CellLabel->
  "In[147]:=",ExpressionUUID->"becd38fb-5870-4813-8863-a0501acddbcd"],

Cell[BoxData["12238999390754304"], "Output",
 CellChangeTimes->{{3.8317746248265667`*^9, 3.831774637753846*^9}},
 CellLabel->
  "Out[147]=",ExpressionUUID->"e24e2df4-82e1-4a1d-a463-372e1806b3f6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Equating coefficients", "Subsection",
 CellChangeTimes->{{3.831675027443103*^9, 
  3.831675030851186*^9}},ExpressionUUID->"d177ca86-3a5d-4c4a-9796-\
233212632765"],

Cell[TextData[{
 "To equate the coefficients and find the parameters of a polynomial through \
equating coefficients, use:\n",
 StyleBox["SolveAlways[ {",
  FontSize->24],
 StyleBox["LHS == RHS",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["} ,{",
  FontSize->24],
 StyleBox["var",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}]\n",
  FontSize->24],
 StyleBox["Note that the variable is NOT the parameter you are trying to \
solve for, it is what the polynomial is in terms of (",
  FontSize->24,
  FontWeight->"Bold"],
 StyleBox["x",
  FontSize->24,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[").",
  FontSize->24,
  FontWeight->"Bold"],
 StyleBox["\[LineSeparator]",
  FontSize->24],
 StyleBox["EG:",
  FontSize->14]
}], "Text",
 CellChangeTimes->{{3.831675039649128*^9, 
  3.83167515702383*^9}},ExpressionUUID->"68aaa338-5f41-4c97-bc06-\
b1c6efc09ed7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SolveAlways", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", "h"}], ")"}], "2"]}], "+", "k"}], "\[Equal]", 
    RowBox[{
     RowBox[{"3", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"7", "x"}], "-", "9"}]}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.831675165032913*^9, 3.8316752091808968`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"cd7d04f8-4f96-4926-887f-fe4200301a69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"k", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["157", "12"]}]}], ",", 
    RowBox[{"a", "\[Rule]", "3"}], ",", 
    RowBox[{"h", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["7", "6"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.831675209531012*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"be8704b8-7647-42cb-8a6f-64160886e09e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding the equation of a cubic from given info (shortcut?)", \
"Subsection",
 CellChangeTimes->{{3.831675252387972*^9, 
  3.8316752727591667`*^9}},ExpressionUUID->"7ee679af-8d74-46db-b815-\
60292952ae2e"],

Cell[TextData[{
 "For a question like \[OpenCurlyDoubleQuote]find the equation of a quartic \
that passes through the points (0,3), (3,7), (5,14), (12,122) ,(13,153)\
\[CloseCurlyDoubleQuote] :\n1) define the function of the quartic : f[x_]:= a \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "4"], "+", 
    RowBox[{"b", " ", 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{"c", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"d", " ", "x"}], "+", "e"}], TraditionalForm]],ExpressionUUID->
  "ee18095b-141b-4b5a-86f6-91271463a59f"],
 "\n2) solve using:\n",
 StyleBox["Solve[ f [ {0,3,5,12,13} ] ==  {3,7,14,122,153}, {a , b, c, d, e} \
]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.831675277084667*^9, 3.83167548551693*^9}, {
  3.8316755300985518`*^9, 
  3.831675536502366*^9}},ExpressionUUID->"4b746e1e-820f-48b5-b6a9-\
7ee309cec749"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  RowBox[{"a", " ", 
   FormBox[
    RowBox[{
     SuperscriptBox["x", "4"], "+", 
     RowBox[{"b", " ", 
      SuperscriptBox["x", "3"]}], "+", 
     RowBox[{"c", " ", 
      SuperscriptBox["x", "2"]}], "+", 
     RowBox[{"d", " ", "x"}], "+", "e"}],
    TraditionalForm]}]}]], "Input",
 CellChangeTimes->{{3.8316754917970123`*^9, 3.831675520554645*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"99b85b2a-1de2-46c2-aa0e-44b6ba02e2fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"{", 
      RowBox[{"0", ",", "3", ",", "5", ",", "12", ",", "13"}], "}"}], "]"}], 
    "\[Equal]", 
    RowBox[{"{", 
     RowBox[{"3", ",", "7", ",", "14", ",", "122", ",", "153"}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.831675553154044*^9, 3.831675582114822*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"23e61f1d-5d8e-427c-a323-a2140d53d781"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["37", "39312"]}]}], ",", 
    RowBox[{"b", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["18312", "185"]}]}], ",", 
    RowBox[{"c", "\[Rule]", 
     FractionBox["10451", "37"]}], ",", 
    RowBox[{"d", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["259032", "185"]}]}], ",", 
    RowBox[{"e", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["117936", "37"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.831675582795258*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"6e4cce94-5208-4454-a9a7-0c1781fe32a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Combinations", "Subsection",
 CellChangeTimes->{{3.840052084762374*^9, 
  3.840052088021285*^9}},ExpressionUUID->"fc055161-85e3-469c-997a-\
dbbf5251bc87"],

Cell[TextData[{
 "Combinations can be written in mathematica as ",
 StyleBox["Binomial[ n, r ]",
  FontSize->24],
 StyleBox[" \[OpenCurlyDoubleQuote]nCr: number of ways to choose ",
  FontSize->14],
 StyleBox["n",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[" out of ",
  FontSize->14],
 StyleBox["r",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox["\[CloseCurlyDoubleQuote]",
  FontSize->14]
}], "Text",
 CellChangeTimes->{{3.84005209199934*^9, 3.840052134483886*^9}, {
  3.870054272734767*^9, 
  3.870054273048999*^9}},ExpressionUUID->"561c34f4-c054-4144-8a9d-\
f9455216833b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Defining a discrete distribution", "Subsection",
 CellChangeTimes->{{3.8400515789175253`*^9, 
  3.840051588261903*^9}},ExpressionUUID->"2e697b7e-5aab-4773-b526-\
1291d50bad20"],

Cell[TextData[{
 "A discrete distribution can be defined using the Empiricaldistribution[...] \
command (**Note that only using this command does not give u full marks**)\n\
",
 StyleBox["Dist = EmpiricalDistribution[{",
  FontSize->24],
 StyleBox["p",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["1",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[" , p",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["2",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[" , p",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["3",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[", ...",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["} -> {X",
  FontSize->24],
 StyleBox["1 ",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[", X",
  FontSize->24],
 StyleBox["2 ",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[", X",
  FontSize->24],
 StyleBox["3",
  FontSize->14,
  FontSlant->"Italic"],
 StyleBox[" , ...} ]\n",
  FontSize->24],
 StyleBox["Note",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox[" that the order of the probabilities ",
  FontSize->14],
 StyleBox["MUST match up ",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox["with the order of values of x ",
  FontSize->14],
 StyleBox["\n",
  FontSize->14,
  FontWeight->"Bold"],
 StyleBox["The defined variable can be used as a distribution; eg:",
  FontSize->14]
}], "Text",
 CellChangeTimes->{{3.840051634075602*^9, 3.8400516964040947`*^9}, {
  3.840051760940791*^9, 3.84005189842292*^9}, {3.8400520309579563`*^9, 
  3.8400520454403954`*^9}},ExpressionUUID->"c1bd4cb0-b7ed-4572-b50f-\
3a96002d81ef"],

