  RowBox[{"euler", "[", 
   RowBox[{"f", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", "2", ",", "0.5"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", "f", "]"}], "\[IndentingNewLine]", 
