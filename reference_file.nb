Cell[CellGroupData[{

Cell["Solving Equations", "Subsection",
 CellChangeTimes->{{3.838423548953394*^9, 
  3.8384235520603848`*^9}},ExpressionUUID->"7de463c4-6a88-4bb5-bd20-\
ed4b2dac1c08"],

Cell["\<\
Note to use ComplexExpand to get the answers in Cartesian form, eg:\
\>", "Text",
 CellChangeTimes->{{3.838423560958355*^9, 3.8384235884234047`*^9}, 
   3.842546102724267*^9},ExpressionUUID->"428c7218-6e14-4bd0-a924-\
89c11104b76a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "z", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ComplexExpand", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["z", "3"], "+", 
       RowBox[{"2", 
        SuperscriptBox["z", "2"]}]}], "\[Equal]", 
      RowBox[{"-", "1"}]}], ",", "z"}], "]"}], "]"}], "//", "N"}]}], "Input",
 CellChangeTimes->{{3.83842359082449*^9, 3.838423631022964*^9}, {
  3.842546421181884*^9, 3.8425464472438717`*^9}},
 CellLabel->
  "In[409]:=",ExpressionUUID->"0b6fb474-7ea7-40d0-ab58-615f89fde968"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{"-", "2.2055694304005904`"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{"0.10278471520029515`", "\[VeryThinSpace]", "-", 
      RowBox[{"0.6654569511528134`", " ", "\[ImaginaryI]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{"0.10278471520029515`", "\[VeryThinSpace]", "+", 
      RowBox[{"0.6654569511528134`", " ", "\[ImaginaryI]"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.838423614276062*^9, 3.838423631574568*^9}, {
  3.842546426829321*^9, 3.842546447484828*^9}},
 CellLabel->
  "Out[410]=",ExpressionUUID->"e5a88a54-1b11-4ff3-ab74-111d1d614983"]
}, Open  ]],

