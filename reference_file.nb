               "]"}], "[", 
              RowBox[{"RadicalDenest", "::", "msg4"}], "]"}], ";", 
             "$Failed"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"FinExpr2", "=", 
        RowBox[{"TimeConstrained", "[", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"RationalizeDenominator", "[", 
