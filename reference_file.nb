Cell[TextData[{
 "impdiff[EQUATION, (variable w/ respect to ), (diff of what being asked)]\n\n\
eg: find dy/dx if x= x y ",
 Cell[BoxData[
  FormBox[
   RowBox[{"+", 
    SuperscriptBox["y", "2"]}], TraditionalForm]],ExpressionUUID->
  "9ab8f343-f4f8-42d4-af67-336a310465d7"]
}], "Text",
 CellChangeTimes->{{3.8707533282258673`*^9, 
  3.870753410698289*^9}},ExpressionUUID->"626516f8-b157-458e-8c4d-\
8425e04ceffa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"impdiff", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", "y"}], " ", "+", 
     SuperscriptBox["y", "2"]}], "\[Equal]", "x"}], ",", "x", ",", "y"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.8707533897645206`*^9, 3.870753414675397*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"800faf8e-d46d-40ba-aa8d-63227ca588d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Dt", "[", 
     RowBox[{"y", ",", "x"}], "]"}], "\[Rule]", 
    FractionBox[
     RowBox[{"1", "-", "y"}], 
     RowBox[{"x", "+", 
      RowBox[{"2", " ", "y"}]}]]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.8707534149563828`*^9},
 CellLabel->
  "Out[274]=",ExpressionUUID->"7ed86b1e-2c82-4edc-a1b5-72972409a71a"]
}, Open  ]],

