Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"99", "%", " ", "confidence", " ", "interval"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Probability", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "k"}], "<", "z", "<", "k"}], ",", 
       RowBox[{"z", "\[Distributed]", 
        RowBox[{"NormalDistribution", "[", "]"}]}]}], "]"}], "\[Equal]", 
     "0.99"}], ",", "k"}], "]"}]}]], "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"ca6b64de-6a78-429a-addd-b9d148fc2647"],

