Cell[CellGroupData[{

Cell["Hypergeometric distribution", "Subsection",
 CellChangeTimes->{{3.840167541676887*^9, 
  3.840167546037979*^9}},ExpressionUUID->"e0866191-7dc2-4df9-a584-\
55da897e6f6c"],

Cell[TextData[{
 "When determining the distribution of X for small sample size (n values), \
the hypergeometric distribution should be used instead of the binomial \
distribution. The distribution states;\n",
 StyleBox["Pr(X = x) = ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         SubscriptBox["n", "suc"]},
        {"x"}
       }], ")"}], " ", 
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["n", "tot"], "-", 
          SubscriptBox["n", "suc"]}]},
        {
         RowBox[{"n", "-", "x"}]}
       }], ")"}]}], 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["n", "tot"]},
       {"n"}
      }], ")"}]], TraditionalForm]],ExpressionUUID->
  "dd48f2c3-a469-4e84-9e3a-db1c8c50c10b"],
 StyleBox["  where ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "tot"], "-", 
    SubscriptBox["n", "suc"]}], TraditionalForm]],ExpressionUUID->
  "b861b1ad-81d3-48b7-809c-925386f1d4d3"],
 StyleBox["=",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "fail"], TraditionalForm]],ExpressionUUID->
  "5b9619fb-6154-458b-b4a3-239b8133b047"],
 StyleBox[".",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.840167553885336*^9, 
  3.840167655791807*^9}},ExpressionUUID->"4f267b02-e60a-40de-a14b-\
748ac94c39dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Finding confidence intervals", "Subsection",
 CellChangeTimes->{{3.843964333738924*^9, 
  3.843964339751947*^9}},ExpressionUUID->"940879d0-165a-4f79-bf7e-\
77b358755c47"],

Cell[TextData[{
 "To find a confidence interval of a r.v with a known mean and standard \
deviation, use\n",
 StyleBox["NormalCI[{mean},{sd},ConfidenceLevel-> {decimal}]",
  FontSize->18]
}], "Text",
