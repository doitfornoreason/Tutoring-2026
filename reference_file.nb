Cell[CellGroupData[{

Cell["Eulers method", "Subsection",
 CellChangeTimes->{{3.868319800245949*^9, 
  3.868319801882105*^9}},ExpressionUUID->"d7ed6bb3-882c-4a4d-9af6-\
3778cabbca89"],

Cell[TextData[{
 "1. Define the derivative as f:\n\n",
 StyleBox["f[ x_ , y_ ] := ...\n\n",
  FontSize->18],
 StyleBox["2. Use the following:\n\n",
  FontSize->14],
 StyleBox["euler[ ",
  FontSize->18],
 StyleBox["derivative",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[" , {x0, y0} , xf , stepsize]",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.8683199529767027`*^9, 
  3.868320088897731*^9}},ExpressionUUID->"26c7595e-8ac3-453f-a54a-\
018cb450f56b"],

