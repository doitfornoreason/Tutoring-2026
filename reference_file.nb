Cell[CellGroupData[{

Cell["Finding a vector perpendicular to another", "Subsection",
 CellChangeTimes->{{3.831871396843951*^9, 3.83187141242204*^9}, {
  3.831871452240686*^9, 
  3.83187146425609*^9}},ExpressionUUID->"771f615b-2ccd-4a8d-ae5b-\
635437a2c524"],

Cell[TextData[{
 "use;\n",
 StyleBox["Cross [ u ]\n",
  FontSize->24],
 StyleBox["You can use more than one input in the argument of the command:\n",
  
  FontSize->14],
 StyleBox["Cross[ u , v ]\n",
  FontSize->18],
 StyleBox["finds a vector perpendicular to u and v (must be three \
dimensional)",
  FontSize->14]
}], "Text",
 CellChangeTimes->{{3.831871468883198*^9, 
  3.831871525185833*^9}},ExpressionUUID->"5d903ed0-29d6-448a-8484-\
58f3193d1931"],

