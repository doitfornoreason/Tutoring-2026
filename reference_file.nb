   RowBox[{
    RowBox[{"isCorrectFactor", "[", 
     RowBox[{"poly_", ",", "var_", ",", "val_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "roots", "}"}], ",", 
      RowBox[{
       RowBox[{"roots", "=", 
