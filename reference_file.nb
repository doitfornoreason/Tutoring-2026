Cell[CellGroupData[{

Cell["Using DSolve for vector calc", "Subsection",
 CellChangeTimes->{{3.869863646076565*^9, 
  3.869863650695612*^9}},ExpressionUUID->"5e91d500-cd7c-48f7-bce1-\
3249d1abb186"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[IndentingNewLine]", "1", ")"}], " ", "Define", " ", "the", " ",
     "position", " ", "vector", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
      "we", " ", "need", " ", "to", " ", "some", " ", "how", " ", "define", 
       " ", "v", " ", "as", " ", "a", " ", "derivative", " ", "of", " ", 
       "r"}], ",", " ", "etc"}], ")"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}], ",", 
      RowBox[{"z", "[", "t", "]"}]}], "}"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{"Define", " ", "the", " ", "velocity", " ", "vector"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"v", "[", "t_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["t", "2"], ",", 
      RowBox[{"2", "t"}], ",", 
      RowBox[{"-", "t"}]}], "}"}]}], 
   RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
    "Equate", " ", "the", " ", "velocity", " ", "to", " ", "the", " ", 
     "derivative", " ", "of", " ", "r", " ", "in", " ", "dsolve", " ", "and", 
     " ", "give", " ", "it", " ", "initial", " ", "conditions"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "THE", " ", "FORMAT", " ", "ISNT", " ", "THE", " ", "SAME", " ", "AS", 
     " ", "REGULAR", " ", "DSOLVE"}], "\[IndentingNewLine]", "*)"}], 
   RowBox[{"DSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"r", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"v", "[", "t", "]"}]}], "&&", 
      RowBox[{
       RowBox[{"r", "[", "0", "]"}], "\[Equal]", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], ",", 
     RowBox[{"r", "[", "t", "]"}], ",", "t"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.869863655180299*^9, 3.869863828017817*^9}, {
  3.869863885897581*^9, 
  3.869863933773225*^9}},ExpressionUUID->"32ee5d17-16fe-4e59-b7fe-\
ef8c6d735e0c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox["1", "3"], " ", 
      RowBox[{"(", 
       RowBox[{"3", "+", 
        SuperscriptBox["t", "3"]}], ")"}]}]}], ",", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "\[Rule]", 
     RowBox[{"1", "+", 
      SuperscriptBox["t", "2"]}]}], ",", 
    RowBox[{
     RowBox[{"z", "[", "t", "]"}], "\[Rule]", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"(", 
       RowBox[{"2", "-", 
        SuperscriptBox["t", "2"]}], ")"}]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.869863828281809*^9, 3.869863914233392*^9},
 CellLabel->
  "Out[573]=",ExpressionUUID->"02b80726-1d12-432c-9f53-4c87cb596ea6"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Use", " ", 
    RowBox[{"DSolveValue", "[", "...", "]"}], " ", "to", " ", "get", " ", 
    "the", " ", "output", " ", "in", " ", "array", " ", "format"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"r", "'"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"v", "[", "t", "]"}]}], "&&", 
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "\[Equal]", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1"}], "}"}]}]}], ",", 
    RowBox[{"r", "[", "t", "]"}], ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.869863835713923*^9, 3.86986386130334*^9}},
 CellLabel->
  "In[567]:=",ExpressionUUID->"2732c943-9ddf-4446-845d-b2e3c36d4c15"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"3", "+", 
      SuperscriptBox["t", "3"]}], ")"}]}], ",", 
   RowBox[{"1", "+", 
    SuperscriptBox["t", "2"]}], ",", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"2", "-", 
      SuperscriptBox["t", "2"]}], ")"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.869863861557761*^9},
 CellLabel->
  "Out[567]=",ExpressionUUID->"dffcc153-2b55-456d-8c48-16c816bad0bf"]
}, Open  ]]
}, Closed]],

