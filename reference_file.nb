Cell[BoxData[
 RowBox[{"parinfo", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"t", "+", "1"}], ",", 
     RowBox[{"t", "+", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.869872348979959*^9, 3.869872362724608*^9}},
