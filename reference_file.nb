                  RowBox[{"(", 
                   RowBox[{"1", "/", "power"}], ")"}]}]}]}], "]"}], "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"j", "++"}], ";", "\[IndentingNewLine]", 
