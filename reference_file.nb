Cell[CellGroupData[{

Cell["Vector and scalar resolute", "Subsection",
 CellChangeTimes->{{3.8318723312379627`*^9, 
  3.8318723397145443`*^9}},ExpressionUUID->"f3b03885-0df8-417d-9e01-\
bd0d26e82ef5"],

Cell[TextData[{
 "The ",
 StyleBox["vector resolute",
  FontWeight->"Bold"],
 " of u in the direction of v is given by\n",
 StyleBox["Projection[ u , v ]",
  FontSize->24]
}], "Text",
