 CellLabel->"Out[38]=",ExpressionUUID->"68263e68-1bdc-4b6c-aa59-09c4cf067afb"]
}, Open  ]],

Cell[TextData[{
 StyleBox["From cartesian to polar coordiantes (x , y)-> (r , theta)\n",
  FontSize->16,
