  3.86717460353662*^9, 
  3.8671746043018103`*^9}},ExpressionUUID->"a523b776-a04f-471a-927c-\
bf6b7a302d7e"],

Cell[TextData[StyleBox["DSolve[ {Eqn, init} , y[x] , x ]",
 FontSize->24]], "Text",
 CellChangeTimes->{{3.867174553325576*^9, 
  3.867174576400044*^9}},ExpressionUUID->"0d021e0e-8c85-4481-bfc6-\
d01dc3341d72"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "x", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"y", "[", "x", "]"}], "2"], "-", 
       RowBox[{"y", "[", "x", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"y", "[", "1", "]"}], "\[Equal]", "3"}]}], "}"}], ",", 
   RowBox[{"y", "[", "x", "]"}], ",", "x"}], "]"}]], "Input",
 CellChangeTimes->{{3.867174583172401*^9, 3.867174601560194*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"9563b48a-2249-49e2-a04b-515dd6e65149"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"y", "[", "x", "]"}], "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"3", " ", "\[ExponentialE]"}], 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", "\[ExponentialE]"}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["\[ExponentialE]", "x"]}]}]]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.8671746063345137`*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"4989039f-ca5a-4bf4-a773-12872c3b02a6"]
}, Open  ]],

Cell[TextData[{
 "Can also be solved numerically, however the ",
 StyleBox["domain provided in the code can affect the solution function",
  FontWeight->"Bold"],
 "\n",
 StyleBox["NDsolve[ {DE, ",
  FontSize->24],
 StyleBox["one",
  FontSize->24,
  FontWeight->"Bold"],
 StyleBox[" initial condition} , func , {",
  FontSize->24],
 StyleBox["var, min, max",
  FontSize->24,
  FontSlant->"Italic"],
 StyleBox["}]",
  FontSize->24]
}], "Text",
 CellChangeTimes->{{3.867869362086008*^9, 
  3.867869449331997*^9}},ExpressionUUID->"b3cf7af4-f482-4294-b3ee-\
6baeba69cebc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NDSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["1", 
       RowBox[{
        RowBox[{"y", "'"}], "[", "h", "]"}]], "\[Equal]", 
      RowBox[{
       FractionBox["3", 
        RowBox[{"Pi", " ", 
         SuperscriptBox["h", "2"]}]], 
       RowBox[{"(", 
        RowBox[{"2", "-", 
         RowBox[{
          FractionBox["5", "100"], 
          SqrtBox["h"]}]}], ")"}]}]}], ",", 
     RowBox[{
      RowBox[{"y", "[", "2.5", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
   RowBox[{"y", "[", "h", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"h", ",", "0", ",", "1000"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[850]:=",ExpressionUUID->"ab56addf-fb92-49ce-b590-577f4dfa6461"],

